define

# =============================================================================
# Standalone base schema for mythras-gm.
#
# mythras-gm owns its own TypeDB database ("mythras") and its own root type
# hierarchy. This file defines the small set of base types that the myth- game
# types inherit from: an identity, a name, a description, some prose, and a
# timestamp.
#
# History: these types were once inherited from alhazen-core (as alh-identifiable
# -entity, alh-domain-thing, alh-collection, alh-note). The skill was decoupled
# from Alhazen in August 2026 -- own database, own base types, own session hook,
# vendored helpers -- so nothing here depends on Alhazen any more. The names were
# renamed alh- -> myth- at the same time; there is zero alh- anywhere in the
# skill now.
#
# Load order: this file first, then schema.tql (which subtypes these).
# =============================================================================

attribute id, value string;
attribute name, value string;
attribute description, value string;
attribute content, value string;
attribute created-at, value datetime;

entity myth-identifiable-entity @abstract,
    owns id @key,
    owns name,
    owns description,
    owns created-at;

entity myth-domain-thing sub myth-identifiable-entity,
    owns content;

entity myth-collection sub myth-identifiable-entity,
    owns content;

entity myth-information-content-entity @abstract, sub myth-identifiable-entity,
    owns content;

entity myth-note sub myth-information-content-entity;
