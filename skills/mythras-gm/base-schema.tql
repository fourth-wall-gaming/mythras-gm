define

# =============================================================================
# Minimal standalone base for mythras-gm.
#
# schema.tql inherits from four types it does not define -- alh-identifiable-
# entity, alh-domain-thing, alh-collection and alh-note -- which normally come
# from alhazen-core. That made mythras-gm unable to provision a database of its
# own, which in turn made test isolation impossible: the suite had no throwaway
# database to write to, so it wrote to the live game and left 21 fixture
# campaigns behind before anyone looked.
#
# This file is that base, reduced to exactly what the myth- types use: an
# identity, a name, a description, some prose, and a timestamp. None of
# alhazen's classification, tagging, provenance, aboutness or citation
# machinery is used by this skill.
#
# Definitions are a strict SUBSET of alhazen-core's, with matching names,
# abstractness and cardinality, so loading this into a database that already
# has the full core schema is a no-op. Loading it into an empty database gives
# mythras-gm a home of its own.
#
# First step of the standalone-database pivot; the type names stay `alh-` for
# now so schema.tql needs no edit.
# =============================================================================

attribute id, value string;
attribute name, value string;
attribute description, value string;
attribute content, value string;
attribute created-at, value datetime;

entity alh-identifiable-entity @abstract,
    owns id @key,
    owns name,
    owns description,
    owns created-at;

entity alh-domain-thing sub alh-identifiable-entity,
    owns content;

entity alh-collection sub alh-identifiable-entity,
    owns content;

entity alh-information-content-entity @abstract, sub alh-identifiable-entity,
    owns content;

entity alh-note sub alh-information-content-entity;
