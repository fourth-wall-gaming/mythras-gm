{
  "description": "Bring the game's database, schema and rules graph up before the session starts, and refuse loudly if that is impossible.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 180000,
            "statusMessage": "Checking the Mythras save file",
            "async": false
          }
        ]
      }
    ]
  }
}
